{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/unified-motion-director/storyboard.schema.json",
  "title": "Unified Motion Director storyboard v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["film_id", "title", "concept", "duration_sec", "fps", "aspect_ratios", "scenes"],
  "properties": {
    "film_id": {"type":"string","pattern":"^[a-z0-9][a-z0-9-]*$"},
    "title": {"type":"string","minLength":1},
    "concept": {"type":"string","minLength":10},
    "visual_motif": {"type":"string"},
    "duration_sec": {"type":"number","exclusiveMinimum":0},
    "fps": {"type":"integer","minimum":1,"maximum":120},
    "aspect_ratios": {"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","pattern":"^[1-9][0-9]*:[1-9][0-9]*$"}},
    "audio": {"type":"object","properties":{"voiceover":{"type":"boolean"},"music":{"type":"string"},"license":{"type":"string"},"timing_status":{"enum":["measured","illustrative","none"]}},"additionalProperties":true},
    "assets": {"type":"array","items":{"type":"object","required":["id","type","status"],"properties":{"id":{"type":"string"},"type":{"type":"string"},"status":{"enum":["provided","needed","concept"]},"source":{"type":"string"},"license":{"type":"string"}},"additionalProperties":true}},
    "scenes": {
      "type":"array","minItems":1,
      "items": {
        "type":"object","additionalProperties":false,
        "required":["id","start_sec","end_sec","purpose","why_this_scene","subject","source_status","on_screen_text","frame","camera","action","motion","transition","sound","continuity","keyframe_notes"],
        "properties": {
          "id":{"type":"string","pattern":"^S[0-9]+$"},
          "start_sec":{"type":"number","minimum":0},
          "end_sec":{"type":"number","exclusiveMinimum":0},
          "purpose":{"type":"string","minLength":4},
          "why_this_scene":{"type":"string","minLength":10},
          "subject":{"type":"string","minLength":3},
          "source_status":{"enum":["verified","concept","illustrative"]},
          "on_screen_text":{"type":"array","items":{"type":"string"}},
          "frame":{"type":"object","required":["composition","focal_point","safe_area"],"properties":{"composition":{"type":"string"},"focal_point":{"type":"string"},"safe_area":{"type":"string"}},"additionalProperties":true},
          "camera":{"type":"object","required":["type","movement"],"properties":{"type":{"type":"string"},"movement":{"type":"string"}},"additionalProperties":true},
          "action":{"type":"string","minLength":3},
          "motion":{"type":"object","required":["motivation","easing","signature_move"],"properties":{"motivation":{"type":"string"},"easing":{"type":"string"},"signature_move":{"type":"string"}},"additionalProperties":true},
          "transition":{"type":"object","required":["type","shared_element","seam_note"],"properties":{"type":{"type":"string"},"shared_element":{"type":"string"},"entry_state":{"type":"string"},"exit_state":{"type":"string"},"seam_note":{"type":"string"}},"additionalProperties":true},
          "sound":{"type":"object","required":["cue_label","status"],"properties":{"cue_label":{"type":"string"},"cue_time_sec":{"type":["number","null"]},"status":{"enum":["measured","illustrative","none"]}},"additionalProperties":true},
          "continuity":{"type":"object","required":["entry","exit"],"properties":{"entry":{"type":"string"},"exit":{"type":"string"}},"additionalProperties":true},
          "keyframe_notes":{"type":"array","minItems":1,"items":{"type":"string"}},
          "technique_refs":{"type":"array","items":{"type":"string"}}
        }
      }
    }
  }
}
